serverselectwindow:nswindow {

	int	widthpix	450

	int	heightpix	260


	titlestatictext : nstitlestatictext {

		string	text	"str_ldl_DIRECT_TITLE"
		int	widthpix	240
	}



#	selectserverstatictext:nsstatictext {

